rules_version = '2';

// Security Rules Futterrechner „Stall Ultra“
// Grundsatz: Daten eines Betriebs darf nur ein Gerät lesen/schreiben, das in betriebe/{betriebId}/geraete/{uid} steht.
// Geräte-Identität = anonyme Firebase-Anmeldung (request.auth.uid). Alles, was hier nicht erlaubt ist, ist verboten.
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    function pfad(p) {
      return /databases/$(database)/documents/$(p);
    }

    function istGeraet(betriebId) {
      return angemeldet() && exists(/databases/$(database)/documents/betriebe/$(betriebId)/geraete/$(request.auth.uid));
    }

    // Nur diese Felder ändern sich (alle anderen bleiben gleich)
    function nurFelder(felder) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder);
    }

    // ---------- Betrieb ----------
    match /betriebe/{betriebId} {
      allow read: if istGeraet(betriebId);
      allow update: if istGeraet(betriebId) && nurFelder(['name'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 100;

      // Futterdaten: futter (Rationen), einstellungen, lager
      match /daten/{dok} {
        allow read: if istGeraet(betriebId);
        allow write: if istGeraet(betriebId) && dok in ['futter', 'einstellungen', 'lager'];
      }

      // Tageslog: je Eintrag ein Dokument
      match /history/{eintragId} {
        allow read, write: if istGeraet(betriebId);
      }

      // Lieferungen: je Lieferung ein Dokument
      match /lieferungen/{lieferId} {
        allow read, write: if istGeraet(betriebId);
      }

      // Geräte des Betriebs
      match /geraete/{geraetUid} {
        allow read: if istGeraet(betriebId);
        // Name eines Geräts ändern
        allow update: if istGeraet(betriebId) && nurFelder(['name'])
                      && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        // Jedes Gerät des Betriebs darf Geräte entfernen (auch sich selbst)
        allow delete: if istGeraet(betriebId);
      }
    }

    // ---------- Zuordnung Gerät → Betrieb ----------
    // Damit ein Gerät beim Start seinen Betrieb findet. Lesen nur das eigene.
    match /geraetezuordnung/{geraetUid} {
      allow get: if angemeldet() && request.auth.uid == geraetUid;
      // Beim Entfernen eines Geräts wird auch seine Zuordnung gelöscht – von einem Gerät desselben Betriebs oder vom Gerät selbst
      allow delete: if angemeldet() && (request.auth.uid == geraetUid || istGeraet(resource.data.betriebId));
    }

    // Alles andere: gesperrt
  }
}
